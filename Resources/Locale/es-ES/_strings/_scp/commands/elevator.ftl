elevator-manage-floors-desc = Administra los pisos del elevador indicado: añadir, eliminar, mover o enumerar.
elevator-manage-floors-help = Uso: { $command } <elevator_id> <acción> [nombre_del_piso] [dirección]\nAcciones: add <nombre_del_piso>, remove <nombre_del_piso>, move <nombre_del_piso> <dirección>, list\nDirecciones para move: up, down o un número de índice
elevator-manage-floors-not-found = No se encontró el elevador con ID «{ $elevatorId }».
elevator-manage-floors-floor-exists = El piso «{ $floorName }» ya existe en el elevador «{ $elevatorId }».
elevator-manage-floors-added = Se añadió el piso «{ $floorName }» al elevador «{ $elevatorId }». Pisos actuales: { $floors }
elevator-manage-floors-floor-not-exists = El piso «{ $floorName }» no existe en el elevador «{ $elevatorId }».
elevator-manage-floors-cannot-remove-current = No se puede eliminar el piso actual «{ $floorName }» del elevador «{ $elevatorId }».
elevator-manage-floors-removed = Se eliminó el piso «{ $floorName }» del elevador «{ $elevatorId }». Pisos actuales: { $floors }
elevator-manage-floors-list = Pisos del elevador «{ $elevatorId }»: { $floors }\nPiso actual: { $currentFloor }
elevator-manage-floors-move-help = Para la acción «move», indica floor_name y la dirección: { $command } <elevator_id> move <floor_name> <direction>\nDirecciones: up, down o un número de índice (comenzando en 0)
elevator-manage-floors-already-top = El piso «{ $floorName }» ya está en la posición superior.
elevator-manage-floors-already-bottom = El piso «{ $floorName }» ya está en la posición inferior.
elevator-manage-floors-invalid-index = Índice «{ $index }» no válido. Debe estar entre 0 y { $maxIndex }.
elevator-manage-floors-unknown-direction = Dirección desconocida «{ $direction }». Usa «up», «down» o un número de índice válido.
elevator-manage-floors-moved = Se movió el piso «{ $floorName }» a la posición { $newIndex }. Pisos actuales: { $floors }
elevator-manage-floors-unknown-action = Acción desconocida «{ $action }». Acciones válidas: add, remove, move, list.
elevator-manage-floors-args-error = Se esperaban al menos 2 argumentos: elevator_id y action.
